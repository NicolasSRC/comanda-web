# URL base de la API, sin el prefijo /api.
# En desarrollo se recomienda dejar vacío para usar el proxy de Vite (/api -> http://localhost:3000).
# En producción, por ejemplo: https://api.midominio.com
VITE_API_URL=

# Slug del restaurante cuya carta pública se muestra en "/".
VITE_RESTAURANT_SLUG=demo
